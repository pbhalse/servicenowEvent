        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var totalBudget = current.total_budget;
    var amountSpent = current.amount_spent;
    var remainingAmount = totalBudget - amountSpent;
    if (remainingAmount < 0) {
        gs.addErrorMessage('Amount Spent Exceeds Total Budget');
 
        current.amount_spent = previous.amount_spent;
        current.amount_remaining = previous.amount_remaining;
		current.setAbortAction(true);				

    } else {
        current.amount_remaining = remainingAmount;
    }

})(current, previous);]]></script>
